{
  "version": "0.2.0",
  "configurations": [


    {
      "name": "Launch Web API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/bin/Debug/net10.0/ReservationSystem.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "http://localhost:\\d+"
      }
    },
    {
      "name": "Launch Blazor Client",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/ReservationSystem.Client"
    }
  ],
  "compounds": [
    {
      "name": "Launch Full Stack (API + Blazor)",
      "configurations": ["Launch Web API", "Launch Blazor Client"]
    }
  ]
}